{
  "name": "output_image_sd35_large",
  "type": "output_chunk",
  "backend_type": "comfyui",
  "media_type": "image",
  "requires_workflow": true,
  "description": "Stable Diffusion 3.5 Large - High quality text-to-image with full triple-encoder (CLIP-L + CLIP-G + T5-XXL) and per-encoder prompts via AI4ArtsEdSD3TextEncode. Terminal fallback target for output_image_sd35_diffusers.",

  "workflow": {
    "5": {
      "inputs": {
        "ckpt_name": "OfficialStableDiffusion/sd3.5_large.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "Load SD3.5 Large (model + VAE)"
      }
    },
    "7": {
      "inputs": {
        "clip_name1": "clip_l.safetensors",
        "clip_name2": "clip_g.safetensors",
        "clip_name3": "t5xxl_fp16.safetensors"
      },
      "class_type": "TripleCLIPLoader",
      "_meta": {
        "title": "TripleCLIPLoader (CLIP-L + CLIP-G + T5-XXL)"
      }
    },
    "9": {
      "inputs": {
        "clip": ["7", 0],
        "min_padding": 0,
        "min_length": 512
      },
      "class_type": "T5TokenizerOptions",
      "_meta": {
        "title": "T5 length"
      }
    },
    "1": {
      "inputs": {
        "clip_l": "",
        "clip_g": "",
        "t5xxl": "",
        "empty_padding": "empty_prompt",
        "clip": ["9", 0]
      },
      "class_type": "AI4ArtsEdSD3TextEncode",
      "_meta": {
        "title": "CLIP Text Encode SD3 (Positive, per-encoder)"
      }
    },
    "6": {
      "inputs": {
        "clip_l": "",
        "clip_g": "",
        "t5xxl": "",
        "empty_padding": "empty_prompt",
        "clip": ["9", 0]
      },
      "class_type": "AI4ArtsEdSD3TextEncode",
      "_meta": {
        "title": "CLIP Text Encode SD3 (Negative)"
      }
    },
    "3": {
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage",
      "_meta": {
        "title": "Empty Latent Image"
      }
    },
    "8": {
      "inputs": {
        "seed": 123456789,
        "steps": 25,
        "cfg": 4.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1,
        "model": ["5", 0],
        "positive": ["1", 0],
        "negative": ["6", 0],
        "latent_image": ["3", 0]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler"
      }
    },
    "2": {
      "inputs": {
        "samples": ["30", 0],
        "vae": ["5", 2]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "4": {
      "inputs": {
        "filename_prefix": "ComfyUI",
        "images": ["2", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    },
    "30": {
      "inputs": {
        "model": ["5", 0],
        "samples": ["8", 0],
        "enabled": false,
        "filename_prefix": "ai4artsed_latent"
      },
      "class_type": "AI4ArtsEdKeepLatent",
      "_meta": {
        "title": "Keep Latent (off unless the run asks)"
      }
    }
  },

  "input_mappings": {
    "prompt": {
      "node_id": "1",
      "field": "inputs.clip_l",
      "source": "{{PREVIOUS_OUTPUT}}",
      "description": "CLIP-L prompt (visual keywords). When per-encoder optimization is inactive, this is the single main prompt; prompt_2/prompt_3 fall back to it."
    },
    "prompt_2": {
      "node_id": "1",
      "field": "inputs.clip_g",
      "source": "{{PREVIOUS_OUTPUT}}",
      "description": "CLIP-G prompt (semantic scene). Falls back to the main prompt when no per-encoder optimization is active."
    },
    "prompt_3": {
      "node_id": "1",
      "field": "inputs.t5xxl",
      "source": "{{PREVIOUS_OUTPUT}}",
      "description": "T5-XXL prompt (natural language = user's interception text). Falls back to the main prompt when no per-encoder optimization is active."
    },
    "negative_prompt": [
      {
        "node_id": "6",
        "field": "inputs.clip_l",
        "default": "",
        "description": "Negative prompt (CLIP-L)"
      },
      {
        "node_id": "6",
        "field": "inputs.clip_g",
        "default": ""
      },
      {
        "node_id": "6",
        "field": "inputs.t5xxl",
        "default": ""
      }
    ],
    "width": {
      "node_id": "3",
      "field": "inputs.width",
      "default": 1024,
      "description": "Image width in pixels"
    },
    "height": {
      "node_id": "3",
      "field": "inputs.height",
      "default": 1024,
      "description": "Image height in pixels"
    },
    "steps": {
      "node_id": "8",
      "field": "inputs.steps",
      "default": 25,
      "description": "Number of sampling steps (higher = better quality, slower)"
    },
    "cfg": {
      "node_id": "8",
      "field": "inputs.cfg",
      "default": 4.5,
      "description": "Classifier Free Guidance scale (how closely to follow prompt)"
    },
    "sampler_name": {
      "node_id": "8",
      "field": "inputs.sampler_name",
      "default": "euler",
      "description": "Sampling algorithm"
    },
    "scheduler": {
      "node_id": "8",
      "field": "inputs.scheduler",
      "default": "normal",
      "description": "Noise scheduling algorithm"
    },
    "denoise": {
      "node_id": "8",
      "field": "inputs.denoise",
      "default": 1.0,
      "description": "Denoise strength (1.0 = full denoise from noise for text-to-image)"
    },
    "seed": {
      "node_id": "8",
      "field": "inputs.seed",
      "default": 123456789,
      "description": "Seed for reproducibility (default: 123456789)"
    },
    "checkpoint": {
      "node_id": "5",
      "field": "inputs.ckpt_name",
      "default": "OfficialStableDiffusion/sd3.5_large.safetensors",
      "description": "Model checkpoint file"
    },
    "keep_latent": {
      "node_id": "30",
      "field": "inputs.enabled",
      "default": false,
      "description": "Write the final latent out, so a set of pictures can be averaged before the decoder (Mean Images)"
    }
  },

  "output_mapping": {
    "node_id": "4",
    "output_type": "image",
    "format": "png",
    "field": "filename_prefix",
    "description": "SaveImage node that outputs the generated image"
  },

  "latent_decoder": {
    "_comment": "How the platform decodes a latent this chunk kept: the mean of a set is decoded by the model that made the set.",
    "model_id": "stabilityai/stable-diffusion-3.5-large",
    "pipeline_class": "StableDiffusion3Pipeline"
  },
  "meta": {
    "estimated_duration_seconds": "12",
    "quality_rating": 3,
    "requires_gpu": true,
    "gpu_vram_mb": 28000,
    "model_file": "sd3.5_large.safetensors",
    "clip_models": [
      "clip_l.safetensors",
      "clip_g.safetensors",
      "t5xxl_fp16.safetensors"
    ],
    "recommended_resolution": "1024x1024",
    "supported_resolutions": [
      "512x512",
      "768x768",
      "1024x1024",
      "1280x1280"
    ],
    "notes": "SD3.5 Large with full triple-encoder (CLIP-L + CLIP-G + T5-XXL) via TripleCLIPLoader + AI4ArtsEdSD3TextEncode — each encoder receives its own optimized prompt, matching the Diffusers path. Previously used DualCLIPLoader (clip_g + t5xxl) which silently dropped the CLIP-L prompt; corrected. prompt_2/prompt_3 fall back to the main prompt via {{PREVIOUS_OUTPUT}} so single-prompt flows still feed all three encoders. Terminal fallback target: defines NO fallback_chunk (was output_image_sd35_diffusers, which created a Diffusers->ComfyUI->Diffusers circular reference; removed)."
  }
}
