  "parameters": {
    "OUTPUT_CHUNK": "output_audio_acenet",
    "LYRICS": "[instrumental]",
    "LYRICS_STRENGTH": 0.99,
    "SECONDS": 30,
    "STEPS": 50,
    "CFG": 5.0,
    "SAMPLER": "dpmpp_2m_sde_gpu",
    "SCHEDULER": "simple",
    "DENOISE": 0.9,
    "seed": "random"
  },
  "media_preferences": {
    "default_output": "audio",
    "supported_types": [
      "audio"
    ]
  },
  "meta": {
    "stage": "output",
    "model": "ace-step-v1.3.5b",
    "model_file": "ace_step_v1_3.5b.safetensors",
    "backend": "comfyui",
    "backend_type": "comfyui",
    "requires_gpu": true,
    "gpu_vram_mb": 8500,
    "estimated_duration_seconds": "10-30",
    "recommended_duration": 30,
    "supported_durations": [
      15,
      30,
      45,
      60
    ],
    "notes": "ACE Step v1.3.5b via ComfyUI. Text-to-audio generation for instrumental music. Generates 30-second instrumental tracks. The 'tags' field describes the musical style, genre, instruments, mood, and tempo.",
    "version": "1.0",
    "display_name": "ACE-Net",
    "publisher": "StepFun / ACE Studio (Beijing, CN)",
    "architecture": "Neural Audio Codec + Transformer",
