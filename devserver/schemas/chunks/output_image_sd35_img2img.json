{
  "name": "output_image_sd35_img2img",
  "type": "output_chunk",
  "backend_type": "comfyui",
  "media_type": "image",
  "requires_workflow": true,
  "description": "Stable Diffusion 3.5 Large image-to-image (ComfyUI). Terminal fallback target for output_image_sd35_img2img_diffusers on GPUs too small for the Diffusers path (no CPU offload) — ComfyUI's own VRAM management runs SD3.5 Large on 24 GB cards. Full triple-encoder with per-encoder prompts (CLIP-L / CLIP-G / T5-XXL) via AI4ArtsEdSD3TextEncode.",

  "workflow": {
    "5": {
      "inputs": {
        "ckpt_name": "OfficialStableDiffusion/sd3.5_large.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "Load SD3.5 Large (model + VAE)"
      }
    },
    "7": {
      "inputs": {
        "clip_name1": "clip_l.safetensors",
        "clip_name2": "clip_g.safetensors",
        "clip_name3": "t5xxl_fp16.safetensors"
      },
      "class_type": "TripleCLIPLoader",
      "_meta": {
        "title": "TripleCLIPLoader (CLIP-L + CLIP-G + T5-XXL)"
      }
    },
    "9": {
      "inputs": {
        "clip": ["7", 0],
        "min_padding": 0,
        "min_length": 512
      },
      "class_type": "T5TokenizerOptions",
      "_meta": {
        "title": "T5 length"
      }
    },
    "1": {
      "inputs": {
        "clip_l": "",
        "clip_g": "",
        "t5xxl": "",
        "empty_padding": "empty_prompt",
        "clip": ["9", 0]
      },
      "class_type": "AI4ArtsEdSD3TextEncode",
      "_meta": {
        "title": "CLIP Text Encode SD3 (Positive, per-encoder)"
      }
    },
    "6": {
      "inputs": {
        "clip_l": "",
        "clip_g": "",
        "t5xxl": "",
        "empty_padding": "empty_prompt",
        "clip": ["9", 0]
      },
      "class_type": "AI4ArtsEdSD3TextEncode",
      "_meta": {
        "title": "CLIP Text Encode SD3 (Negative)"
      }
    },
    "12": {
      "inputs": {
        "image": ""
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load Input Image"
      }
    },
    "13": {
      "inputs": {
        "upscale_method": "lanczos",
        "megapixels": 1.0,
        "resolution_steps": 1,
        "image": ["12", 0]
      },
      "class_type": "ImageScaleToTotalPixels",
      "_meta": {
        "title": "Scale Input to ~1 Megapixel"
      }
    },
    "14": {
      "inputs": {
        "pixels": ["13", 0],
        "vae": ["5", 2]
      },
      "class_type": "VAEEncode",
      "_meta": {
        "title": "VAE Encode (image → latent)"
      }
    },
    "8": {
      "inputs": {
        "seed": 123456789,
        "steps": 25,
        "cfg": 4.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 0.65,
        "model": ["5", 0],
        "positive": ["1", 0],
        "negative": ["6", 0],
        "latent_image": ["14", 0]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler (img2img, denoise < 1)"
      }
    },
    "2": {
      "inputs": {
        "samples": ["8", 0],
        "vae": ["5", 2]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "4": {
      "inputs": {
        "filename_prefix": "ComfyUI",
        "images": ["2", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    }
  },

  "input_mappings": {
    "input_image": {
      "node_id": "12",
      "field": "inputs.image",
      "source": "{{INPUT_IMAGE}}",
      "description": "Input image for img2img (uploaded to ComfyUI by the router, filename injected here)"
    },
    "prompt": {
      "node_id": "1",
      "field": "inputs.clip_l",
      "source": "{{PREVIOUS_OUTPUT}}",
      "description": "CLIP-L prompt (visual keywords). When per-encoder optimization is inactive, this is the single main prompt; prompt_2/prompt_3 fall back to it."
    },
    "prompt_2": {
      "node_id": "1",
      "field": "inputs.clip_g",
      "source": "{{PREVIOUS_OUTPUT}}",
      "description": "CLIP-G prompt (semantic scene). Falls back to the main prompt when no per-encoder optimization is active."
    },
    "prompt_3": {
      "node_id": "1",
      "field": "inputs.t5xxl",
      "source": "{{PREVIOUS_OUTPUT}}",
      "description": "T5-XXL prompt (natural language = user's interception text). Falls back to the main prompt when no per-encoder optimization is active."
    },
    "negative_prompt": [
      {
        "node_id": "6",
        "field": "inputs.clip_l",
        "default": "",
        "description": "Negative prompt (CLIP-L)"
      },
      {
        "node_id": "6",
        "field": "inputs.clip_g",
        "default": ""
      },
      {
        "node_id": "6",
        "field": "inputs.t5xxl",
        "default": ""
      }
    ],
    "strength": {
      "node_id": "8",
      "field": "inputs.denoise",
      "default": 0.65,
      "description": "Denoising strength (ComfyUI 'denoise' == Diffusers 'strength'): 0 = no change, 1 = full regeneration. Matches the Diffusers chunk default 0.65."
    },
    "denoise": {
      "node_id": "8",
      "field": "inputs.denoise",
      "default": 0.65,
      "description": "Alias for strength (denoise amount)."
    },
    "steps": {
      "node_id": "8",
      "field": "inputs.steps",
      "default": 25,
      "description": "Number of sampling steps"
    },
    "cfg": {
      "node_id": "8",
      "field": "inputs.cfg",
      "default": 4.5,
      "description": "Classifier Free Guidance scale"
    },
    "sampler_name": {
      "node_id": "8",
      "field": "inputs.sampler_name",
      "default": "euler",
      "description": "Sampling algorithm"
    },
    "scheduler": {
      "node_id": "8",
      "field": "inputs.scheduler",
      "default": "normal",
      "description": "Noise scheduling algorithm"
    },
    "seed": {
      "node_id": "8",
      "field": "inputs.seed",
      "default": 123456789,
      "description": "Seed for reproducibility"
    },
    "megapixels": {
      "node_id": "13",
      "field": "inputs.megapixels",
      "default": 1.0,
      "description": "Target size in megapixels; preserves aspect ratio of the input image"
    },
    "checkpoint": {
      "node_id": "5",
      "field": "inputs.ckpt_name",
      "default": "OfficialStableDiffusion/sd3.5_large.safetensors",
      "description": "Model checkpoint file"
    }
  },

  "output_mapping": {
    "node_id": "4",
    "output_type": "image",
    "format": "png",
    "field": "filename_prefix",
    "description": "SaveImage node that outputs the generated image"
  },

  "meta": {
    "img2img": true,
    "estimated_duration_seconds": "20-40",
    "requires_gpu": true,
    "gpu_vram_mb": 28000,
    "model_file": "sd3.5_large.safetensors",
    "clip_models": [
      "clip_l.safetensors",
      "clip_g.safetensors",
      "t5xxl_fp16.safetensors"
    ],
    "recommended_resolution": "1024x1024 (~1 MP, aspect ratio preserved from input)",
    "notes": "Full triple-encoder SD3.5 via TripleCLIPLoader + AI4ArtsEdSD3TextEncode — each encoder gets its own optimized prompt (CLIP-L / CLIP-G / T5-XXL), matching the per-encoder optimization and the Diffusers path (which also uses all three). prompt_2/prompt_3 fall back to the main prompt via {{PREVIOUS_OUTPUT}} when per-encoder optimization is inactive, so single-prompt flows still feed all three encoders. Terminal fallback target: defines NO fallback_chunk to avoid the Diffusers->ComfyUI->Diffusers circular reference. Input image is VAE-encoded and partially denoised (denoise<1) so the original composition is preserved."
  }
}
